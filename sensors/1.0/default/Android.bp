package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_interfaces_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_interfaces_license"],
}

cc_library_shared {
    name: "android.hardware.sensors@1.0-impl",
    defaults: ["hidl_defaults"],
    proprietary: true,
    relative_install_path: "hw",
    srcs: ["Sensors.cpp"],
    shared_libs: [
        "liblog",
        "libcutils",
        "libhardware",
        "libbase",
        "libutils",
        "libhidlbase",
        "android.hardware.sensors@1.0",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "multihal",
    ],
    local_include_dirs: ["include/sensors"],
}

cc_library_static {
    name: "android.hardware.sensors@1.0-convert",
    vendor_available: true,
    defaults: ["hidl_defaults"],
    srcs: ["convert.cpp"],
    export_include_dirs: ["include"],
    shared_libs: [
        "liblog",
        "libcutils",
        "libhardware",
        "libbase",
        "libutils",
        "libhidlbase",
        "android.hardware.sensors@1.0",
    ],
    whole_static_libs: [
        "sensors_common_convert",
    ],
    export_static_lib_headers: [
        "sensors_common_convert",
    ],
    local_include_dirs: ["include/sensors"],
    export_shared_lib_headers: [
        "libhardware",
    ],
}

cc_binary {
    name: "android.hardware.sensors@1.0-service",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.sensors@1.0-service.rc"],
// QTI_BEGIN: 2018-09-06: Sensors/Linux: Interfaces: Set binder buffer for sensors HIDL
    defaults: ["hidl_defaults"],
// QTI_END: 2018-09-06: Sensors/Linux: Interfaces: Set binder buffer for sensors HIDL
    srcs: ["service.cpp"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libhidlbase",
        "android.hardware.sensors@1.0",
// QTI_BEGIN: 2018-09-06: Sensors/Linux: Interfaces: Set binder buffer for sensors HIDL
        "libhwbinder",
// QTI_END: 2018-09-06: Sensors/Linux: Interfaces: Set binder buffer for sensors HIDL
    ],
// QTI_BEGIN: 2018-09-06: Sensors/Linux: Interfaces: Set binder buffer for sensors HIDL
    arch: {
        arm: {
            cflags: ["-DARCH_ARM_32"],
        },
    },
// QTI_END: 2018-09-06: Sensors/Linux: Interfaces: Set binder buffer for sensors HIDL
}
